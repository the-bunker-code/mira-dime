// Cloudflare Workers con archivos estáticos: la carpeta del juego se publica tal
// cual (sin build) y worker/index.js atiende solo /api/*.
// Qué NO se publica: .assetsignore. La clave NO va aquí:
// `npx wrangler secret put OPENROUTER_API_KEY`.
{
  "name": "mira-y-dime",
  "compatibility_date": "2026-10-01",
  "main": "worker/index.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
  },
}
